# Caminhos do benchmark e resultados
BENCH_DIR=./specs
GENERATED_DIR=./generated_agents
EXPERIMENTS_RESULTS=./experiments_results

# Sonar — servidor iniciado separadamente em Docker local.
# Modos: external | local | disabled
# external: conecta a um servidor existente, inclusive Docker local.
SONAR_MODE=external
SONAR_REQUIRED=1
SONAR_HOST_URL=http://spec2agent-sonar:9000

# Rede Docker compartilhada entre Sonar e avaliações.
# Precisa existir antes da execução.
EVAL_NETWORK=spec2agent-validation

# Preencha no .env real; nunca versione credenciais.
SONAR_LOGIN=
SONAR_PASSWORD=
USER_TOKEN=

# Somente para SONAR_MODE=local, que inicia uma instalação local:
# SONAR_COMMAND=

# Provider das avaliações: openai | gemini | none.
# Seleciona a chave encaminhada; não altera o modelo definido nos testes.
EVAL_PROVIDER=openai
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Autenticação da geração é separada das avaliações.
# Claude/Codex usam mecanismos de credenciais limitados por provider.
# OpenCode no Docker não herda autenticação/configuração local.

# Controles dos dois pipes
# Repetições por combinação ferramenta × spec; RUN=1 seleciona a run 1.
RUNS=3
# RUN=
# RUNS_FROM=
# RUNS_TO=

# Opcional: nome explícito. Ausente/vazio gera nome com data e hora.
# EXPERIMENT=meu_experimento

# 1 = geração/avaliação Docker; 0 = execução local.
USE_DOCKER=0

# Imagens construídas automaticamente quando ausentes.
# Existentes não são reconstruídas automaticamente.
# GEN_IMAGE=spec2agent-gen:infra
# EVAL_IMAGE=spec2agent-eval:infra

# Os pipes não carregam este arquivo automaticamente.
# Em Bash, carregue seu .env confiável e compatível com shell:
# set -a
# source .env
# set +a
# Coloque valores com espaços/caracteres especiais entre aspas.
