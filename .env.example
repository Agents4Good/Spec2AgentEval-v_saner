# Caminhos
BENCH_DIR=./specs
GENERATED_DIR=./generated_agents
EXPERIMENTS_RESULTS=./experiments_results

# SonarQube já iniciado separadamente na rede Docker de avaliação
SONAR_MODE=external
SONAR_REQUIRED=1
SONAR_HOST_URL=http://spec2agent-sonar:9000
EVAL_NETWORK=spec2agent-validation

# Usadas somente com SONAR_MODE=local
# SONAR_COMMAND=/opt/sonarqube/bin/linux-x86-64/sonar.sh

# Credenciais/configuração do Sonar, se exigidas pelo servidor
SONAR_LOGIN=
SONAR_PASSWORD=
USER_TOKEN=

# Provider usado pelas avaliações. Isso seleciona a chave encaminhada;
# não altera o modelo definido nos testes.
EVAL_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Credenciais para geração. A autenticação varia por CLI.
# OpenCode no Docker não herda a autenticação/configuração local.

# Repetições por combinação ferramenta × spec.
RUNS=3
# RUN=1
# RUNS_FROM=1
# RUNS_TO=3

# Nome opcional do experimento. Se vazio ou omitido, o pipe usa data e hora.
# EXPERIMENT=meu_experimento

# 1 usa Docker para geração e avaliação; 0 executa localmente.
USE_DOCKER=1

# Imagens padrão. Imagens ausentes podem ser construídas automaticamente.
# Imagens existentes não são reconstruídas automaticamente.
# GEN_IMAGE=spec2agent-gen:infra
# EVAL_IMAGE=spec2agent-eval:infra

# Credenciais e IDs usados pelos agentes/testes que integram esses serviços.
NOTION_API_KEY=
NOTION_PAGE_ID=
NOTION_EQUIPMENT_PAGE_ID=
NOTION_RESTRICTIONS_PAGE_ID=
NOTION_CALENDAR_DB_ID=
NOTION_DRAFTS_DB_ID=

TAVILY_API_KEY=
RAPIDAPI_KEY=
GH_TOKEN=
GITHUB_TOKEN=

# Os pipes não carregam este arquivo automaticamente.
# Para carregar um .env confiável e compatível com Bash:
# set -a
# source .env
# set +a
#
# Coloque entre aspas valores com espaços ou caracteres especiais.
# Nunca versione credenciais reais.
