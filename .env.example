# benchmark files
BENCH_DIR=./specs
GENERATED_DIR=./generated_agents
EXPERIMENTS_RESULTS=./experiments_results

# sonarqube (step 03)
# SONAR_COMMAND=
# SONAR_HOST_URL=
# SONAR_LOGIN=
# SONAR_PASSWORD=
# USER_TOKEN=

# models keys (steps 05-08, step 01 nao precisa)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# MCPs and APIs keys
#


# --- Pipeline (pipe.sh) ---
# Quantidade de repetições por combinação ferramenta×agente
RUNS=3
# Nome da bateria (isola resultados em generated_agents/<experiment>/...)
EXPERIMENT=by_tool
# Reruns parciais (opcional): RUN=2 ou RUNS_FROM=2 RUNS_TO=3
#RUN=
#RUNS_FROM=
#RUNS_TO=
# 1 = geração e eval via Docker isolado (docker/README_MVP.md); 0 = host (default)
USE_DOCKER=0
# Imagens (opcional, defaults: spec2agent-gen:mvp / spec2agent-eval:mvp)
#GEN_IMAGE=spec2agent-gen:infra
#EVAL_IMAGE=spec2agent-eval:infra
